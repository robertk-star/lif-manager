# ── Supabase (same project as existing legal-intake-flow) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin auth ────────────────────────────────────────────────────────────────
LIF_ADMIN_PASSWORD=
LIF_ADMIN_SESSION_SECRET=

# ── Partner auth ──────────────────────────────────────────────────────────────
LIF_PARTNER_SESSION_SECRET=

# ── DBS ingest ────────────────────────────────────────────────────────────────
LIF_DBS_INGEST_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
LIF_EMAIL_FROM=Legal Intake Flow <notifications@legalintakeflow.com>
LIF_EMAIL_REPLY_TO=
LIF_APP_URL=https://v2.legalintakeflow.com

